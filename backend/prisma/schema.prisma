// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  PUBLIC
  STAFF
  SUPERADMIN
}

enum ItemStatus {
  ACTIVE
  CLAIMED
  COLLECTED
  RETURNED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  COLLECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CLAIM
}

// Models
model User {
  user_id        String   @id @default(uuid())
  name           String
  phone          String?
  personal_email String   @unique
  password       String
  uni_email      String? @unique
  role           UserRole @default(PUBLIC)
  affiliation    String?

  // Relations
  itemsRecorded  Item[]   @relation("RecordedBy")
  itemsApproved  Item[]   @relation("ApprovedBy")
  claims         ClaimRequest[]
  auditLogs      AuditLog[]

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  deleted_at     DateTime?

  @@index([role])
}

model Building {
  building_id String @id @default(uuid())
  name        String @unique
  address     String?

  rooms       Room[]
  items       Item[]

  created_at  DateTime @default(now())
}

model Room {
  room_id     String  @id @default(uuid())
  room_number Int?    // nullable for rooms with no number (e.g. Student Lounge)
  room_name   String  // always present - display fallback when no number
  
  building_id String
  building    Building @relation(fields: [building_id], references: [building_id])

  items       Item[]

  created_at  DateTime @default(now())

  @@index([building_id])
}

model Category {
  category_id String @id @default(uuid())
  name        String @unique
  description String?

  items       Item[]

  created_at  DateTime @default(now())
}

model Item {
  item_id        String     @id @default(uuid())
  name           String
  description    String?
  color_hex      String?
  color_bucket   String?

  status         ItemStatus @default(ACTIVE)

  // Category
  category_id    String
  category       Category   @relation(fields: [category_id], references: [category_id])

  // Building & Room
  building_id    String
  building       Building   @relation(fields: [building_id], references: [building_id])
  room_id        String
  room           Room       @relation(fields: [room_id], references: [room_id])

  // Found info
  found_at       DateTime
  found_time_known Boolean @default(true)
  expires_at     DateTime?

  // Finder details
  finder_name    String?
  finder_contact String?
  finder_affiliation String?

  // Tracking users
  recorded_by    String
  recorder       User      @relation("RecordedBy", fields: [recorded_by], references: [user_id])
  approved_by    String?
  approver       User?     @relation("ApprovedBy", fields: [approved_by], references: [user_id])

  // Relations
  claims         ClaimRequest[]
  photos         ItemPhoto[]
  audit_logs     AuditLog[]

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  @@index([status])
  @@index([category_id])
  @@index([building_id])
  @@index([room_id])
  @@index([recorded_by])
}

model ItemPhoto {
  photo_id    String   @id @default(uuid())

  item_id     String
  item        Item     @relation(fields: [item_id], references: [item_id])

  storage_url String
  file_key    String?
  mime_type   String?
  size        Int?

  uploaded_at DateTime @default(now())

  @@index([item_id])
}

model ClaimRequest {
  claim_id       String      @id @default(uuid())

  item_id        String
  item           Item        @relation(fields: [item_id], references: [item_id])

  claimer_id     String
  claimer        User        @relation(fields: [claimer_id], references: [user_id])

  status         ClaimStatus @default(PENDING)

  // Ownership explanation
  ownership_desc String
  staff_notes    String?

  requested_at   DateTime @default(now())
  decision_at    DateTime?  // When approved or rejected
  resolved_at    DateTime?  // When collected

  @@index([item_id])
  @@index([claimer_id])
  @@index([status])
}

model AuditLog {
  log_id      String      @id @default(uuid())

  item_id     String
  item        Item        @relation(fields: [item_id], references: [item_id])

  changed_by  String
  user        User        @relation(fields: [changed_by], references: [user_id])

  action      AuditAction
  old_status  ItemStatus?
  new_status  ItemStatus?

  notes       String?

  created_at  DateTime @default(now())

  @@index([item_id])
  @@index([changed_by])
}